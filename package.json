    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.16",
    "electron": "^38.7.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
